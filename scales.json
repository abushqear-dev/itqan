          "1",
          "4"
        ],
        [
          "5",
          "6"
        ]
      ],
      "rounds": 1,
      "limits": {
        "stories": 5,
        "tasks": 8
      },
      "rules": {
        "spec": {
          "sections": [
            "Stack",
            "Later"
          ],
          "edgeCategories": [],
          "lifecycle": "off",
          "goals": false,
          "scopeCuts": false
        },
        "plan": {
          "splitWarn": false
        },
        "build": {
          "review": "none",
          "scaleNote": true
        }
      },
      "includes": [
        "the main path of up to 5 stories, built test-first",
        "a README that runs it",
        "a one-page brief and task list you approve once"
      ],
      "excludes": [
        "competitor research",
        "a Constitution",
        "visual design process and mockups",
        "a separate technical design",
        "security and performance targets",
        "per-task independent review",
        "exploratory testing",
        "quality indices"
      ],
      "envelope": {
        "minutes": 15,
        "usd": 3,
        "approvals": 2
      }
    },
    "demo": {
      "label": "Demo",
