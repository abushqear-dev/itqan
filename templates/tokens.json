{
  "$description": "Design tokens in the W3C Design Tokens Format (2025.10). Replace the placeholder values with the chosen design system's tokens.",
  "color": {
    "$type": "color",
    "background": { "$value": "#ffffff" },
    "text": { "$value": "#1a1a1a" },
    "primary": { "$value": "#0b5fff" },
    "danger": { "$value": "#c62828" }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "body": { "$value": ["system-ui", "sans-serif"] }
    },
    "size": {
      "$type": "dimension",
      "body": { "$value": { "value": 16, "unit": "px" } }
    }
  },
  "space": {
    "$type": "dimension",
    "sm": { "$value": { "value": 8, "unit": "px" } },
    "md": { "$value": { "value": 16, "unit": "px" } }
  },
  "radius": {
    "$type": "dimension",
    "md": { "$value": { "value": 8, "unit": "px" } }
  }
}
