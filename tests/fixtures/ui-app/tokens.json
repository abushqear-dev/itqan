{
  "color": { "$type": "color", "background": { "$value": "#ffffff" }, "text": { "$value": "#1a1a1a" }, "primary": { "$value": "#0b5fff" }, "danger": { "$value": "#c62828" }, "primaryHover": { "$value": "#0847c4" }, "primaryActive": { "$value": "#063a9e" }, "tint": { "$value": "#e8f0ff" }, "disabled": { "$value": "#cfd6e4" }, "border": { "$value": "#6b6b6b" }, "skeleton": { "$value": "#e6e6e6" }, "onPrimary": { "$value": "#ffffff" } },
  "font": { "family": { "$type": "fontFamily", "body": { "$value": ["system-ui", "sans-serif"] } },
            "size": { "$type": "dimension", "body": { "$value": { "value": 16, "unit": "px" } }, "title": { "$value": { "value": 24, "unit": "px" } } } },
  "space": { "$type": "dimension", "sm": { "$value": { "value": 8, "unit": "px" } }, "md": { "$value": "{space.sm2}" }, "sm2": { "$value": { "value": 16, "unit": "px" } } },
  "radius": { "$type": "dimension", "md": { "$value": { "value": 8, "unit": "px" } } },
  "motion": { "$type": "duration", "fast": { "$value": { "value": 200, "unit": "ms" } } }
}
